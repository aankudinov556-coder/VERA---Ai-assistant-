{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Основные права главного окна",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://*"
        },
        {
          "url": "http://*/*"
        },
        {
          "url": "http://*:*/*"
        },
        {
          "url": "https://*"
        },
        {
          "url": "https://*/*"
        },
        {
          "url": "https://*:*/*"
        }
      ]
    }
  ]
}